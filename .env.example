NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- Connection Pooling (Supavisor) ----
# For 100+ concurrent users, replace NEXT_PUBLIC_SUPABASE_URL with the
# Supabase Supavisor pooler URL (transaction mode).
# Find it in: Supabase Dashboard → Project Settings → Database → Connection pooling
# Example: postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# This handles 300+ counsellors simultaneously without exhausting DB connections.
# SUPABASE_DB_URL=your_supavisor_transaction_pooler_url
